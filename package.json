{
  "name": "markify",
  "private": true,
  "version": "0.0.3",
  "description": "Convert web pages to Obsidian-formatted Markdown with YAML frontmatter",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @markify/userscript dev",
    "build": "bunx nx run-many --target=build --all --parallel=4",
    "build:affected": "bunx nx affected --target=build --parallel=4",
    "build:userscript": "bun run --filter @markify/userscript build",
    "graph": "bunx nx graph"
  },
  "devDependencies": {
    "nx": "^22.5.4",
    "@nx/js": "^22.5.4"
  }
}