{
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "config",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": [
        "{projectRoot}/dist",
        "{projectRoot}/tsconfig.tsbuildinfo"
      ]
    },
    "dev": {
      "cache": false
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/node_modules/**/*"
    ],
    "config": [
      "{workspaceRoot}/config/**/*"
    ],
    "core": [
      "default",
      "config"
    ]
  },
  "defaultBase": "main"
}
